{
  "name": "player-exchange",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "pnpm --filter @px/web test:e2e",
    "db:migrate": "bash scripts/migrate.sh",
    "db:seed": "node packages/demo/src/seed-sql.ts | psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q",
    "check:env": "node packages/integrations/src/env-check.ts",
    "ops:restore-check": "node packages/db/ops/restore-check.ts",
    "perf:load": "node packages/db/perf/load.ts",
    "perf:http": "node packages/db/perf/http.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
