{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "APP_MODE",
    "DEMO_LOGIN_ENABLED",
    "DATABASE_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "PAYMENT_PROVIDER",
    "IDENTITY_PROVIDER",
    "FOOTBALL_DATA_PROVIDER",
    "NOTIFICATION_PROVIDER", "PAYMENT_WEBHOOK_SECRET", "WEB_BASE_URL",
    "OIDC_ISSUER",
    "OIDC_CLIENT_ID",
    "OIDC_CLIENT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "test:db": {
      "cache": false
    }
  }
}
