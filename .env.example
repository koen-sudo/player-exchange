# Copy to .env for local demo. Never commit real secrets.

# demo | sandbox | production  (docs/00-dossier.md, "Drie uitvoeringsmodi")
APP_MODE=demo

DATABASE_URL=postgres://px:px@localhost:5432/px_demo
REDIS_URL=redis://localhost:6379

# Session secret for Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-in-local-env

# Demo login: allowed ONLY when APP_MODE=demo. Startup fails otherwise (AT-35).
DEMO_LOGIN_ENABLED=true

# Adapters per mode. "demo" adapters are refused in production.
PAYMENT_PROVIDER=demo
IDENTITY_PROVIDER=demo
FOOTBALL_DATA_PROVIDER=fixture
NOTIFICATION_PROVIDER=demo

# Verifies payment webhooks. The demo value is refused in production.
PAYMENT_WEBHOOK_SECRET=demo-webhook-secret-change-me
# Where the worker reaches the web app (demo: simulated webhooks).
WEB_BASE_URL=http://localhost:3000
# Encrypts drop allocation seeds (64 hex chars). The demo key is refused in production.
DROP_SEED_KEY=d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0

# OIDC (sandbox / production)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
